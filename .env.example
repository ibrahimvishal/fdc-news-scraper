TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_group_or_channel_id

# Dev/monitoring stage only: posts a per-run summary (counts, posted/failed URLs) to the
# Telegram channel and appends it to data/run.log. Set to false (or remove) before wider
# rollout so the channel only carries actual articles.
RUN_SUMMARY_ENABLED=false

# Dev/monitoring stage only: appends a note to each posted message explaining why/how it
# was found. Set to false (or remove) before wider rollout.
POST_REASON_ENABLED=false
